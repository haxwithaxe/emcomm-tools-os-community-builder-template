#!/bin/bash
#
# Fixes magically appearing duplicate instances of the value of `LB_BOOTAPPEND_INSTALL` in `config/binary`
#
# This just runs the `pre-build` script again.
#
# Required Environment Variables
#    BUILD_SH_REPO_DIR: The root of the build repository. Set in `build.sh`.


set -e -o pipefail

SCRIPT_NAME="$(basename "$0")"
"./build.sh.d/${SCRIPT_NAME%.*}.pre-build"
