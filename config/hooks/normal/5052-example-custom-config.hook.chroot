#!/bin/bash

# This is a companion to the "custom-settings/example-custom-config.conf" 
#   example.

# The number prefixing the name of this file was chosen to make sure this runs
#    after hooks that do things it needs done before running and before 
#    everything that will clean up after it.
# In this case it doesn't do anything but if, for instance, it were to 
#    install packages it should run before everything that cleans up after apt
#    and dpkg. If it were to dump junk in /tmp or /var/tmp it should run before
#    the hook that cleans up those directories. 
# If in doubt just make sure it runs after everything except the hooks that have
#    the word "remove" after the number prefix.

# In this hook script we need to call the program that consumes the config if 
#   we want it to be run during the installed OS install process.
# some-program -c /etc/some-program/some-program.conf
