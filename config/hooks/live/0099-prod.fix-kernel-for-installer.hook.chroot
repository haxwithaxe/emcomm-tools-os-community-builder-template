#!/bin/bash

# When the debian installer and the live OS don't have the same kernel
#   the correct version needs to be forced on the live OS.
#
# Exits codes:
# 0: Success.
# 1: Kernel removal failed.
# 2: Kernel install failed.

set -e -o pipefail

# Return the package name for the correct kernel to use with the installer in 
#   the live OS.
get_installer_kernel_package_name() {
	apt showsrc debian-installer \
		| grep Build-Depends \
		| sed 's/, /\n/g' \
		| grep 'linux-image-.*-amd64' \
		| head -n 1 \
		| cut -d ' ' -f 1
}



main() {  # Just keeping the global variable space clean
	echo "Installing the correct kernel in the Live OS to work with the "\
		"debian-installer"
	installer_kernel_package_name=$(get_installer_kernel_package_name)	
	# Removing all the kernels doesn't break anything as long as we put one
	#   back later
	set -x
	apt remove -y linux-image-*-amd64 || exit 1
	apt install -y "$installer_kernel_package_name" || exit 2
	set +x
	echo "The correct kernel (${installer_kernel_package_name}) has been "\
		"installed."
}


main
