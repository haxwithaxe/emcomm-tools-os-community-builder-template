#!/bin/bash

# Install software and configs required for Emcomm Tools OS
# Install supporting packages
# Install Gnome desktop and laptop utilities
apt install -y gnome-core task-laptop live-task-gnome live-task-non-free-firmware-pc live-tools


# Install Emcomm Tools tools
EMCOMM_TOOLS_TMP="$(mktemp -d)"
pushd "$EMCOMM_TOOLS_TMP"
git clone https://github.com/thetechprepper/emcomm-tools-os-community.git
# Run software/config install only. Map/propigation data should probably be downloaded at runtime.
#./scripts/install.sh
/create-dated-flag.sh "/config.hooks.live.$(basename "$0").flag" # FIXME: really install stuff
popd
rm -rf "$EMCOMM_TOOLS_TMP"

